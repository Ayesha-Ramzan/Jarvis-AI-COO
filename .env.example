# ---- Application ----
ENVIRONMENT=development
DEBUG=false
APP_NAME="JARVIS AI COO - Organization-Scoped Skill Registry"
API_V1_PREFIX=/api/v1

# ---- Database (override takes precedence over the individual parts) ----
# DATABASE_URL=postgresql+asyncpg://jarvis:CHANGE_ME@localhost:5432/jarvis
# Credentials are required and have no hardcoded defaults.
# docker compose refuses to start without POSTGRES_PASSWORD set.
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis

# ---- Fixture seeding (idempotent upsert of the two evaluation organizations) ----
SEED_FIXTURE_ORGANIZATIONS=true

# ---- Bearer tokens (optional) ----
# Required for POST /api/v1/auth/token; token issuance returns 503 without it.
# Uncomment and set a strong random value, e.g.: openssl rand -hex 32
# AUTH_SIGNING_KEY=
